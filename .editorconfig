root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_style_readonly_field = true:error
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0161.severity = error
dotnet_diagnostic.CA1852.severity = error
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1848.severity = none

# CA1716 flags type and member names that are reserved words in *another* .NET
# language (VB's Error statement, its Get accessor). Two names it rejects are
# fixed by context: slice-plan.md S01 names `Error` as a shared-kernel type in the
# slice's definition of done, and `ICurrencyRegistry.Get` is the registry lookup
# that ER-9 requires currency scale to come from. Renaming either would be an edit
# to the contract, which is an escalation, not a debugger fix. The solution is C#
# only and exposes no cross-language API, so the rule protects nothing here.
dotnet_diagnostic.CA1716.severity = none

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
